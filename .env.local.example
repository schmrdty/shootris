# OnchainKit Configuration
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key
NEXT_PUBLIC_ONCHAINKIT_PROJECT_ID=your_project_id

# Payment Configuration
NEXT_PUBLIC_PAYOUT_SPLIT_ADDRESS=0xYourPayoutAddress

# $MYU Token Configuration (Base mainnet)
NEXT_PUBLIC_MYU_TOKEN_ADDRESS=0xYourMyuTokenAddressOnBase
NEXT_PUBLIC_MYU_DECIMALS=18
NEXT_PUBLIC_CONTINUE_PRICE_MYU=1000
# PvP entry fee in whole MYU tokens; 0 disables the fee (PvP gameplay is still a stub)
NEXT_PUBLIC_PVP_ENTRY_FEE_MYU=0

# SpacetimeDB Configuration
NEXT_PUBLIC_SPACETIME_MODULE_NAME=shootris-game

# Wallet binding attestation (server-side only, never NEXT_PUBLIC).
# Use a LEAST-PRIVILEGE attestor identity, not your owner token — the owner
# token can republish or delete the database. Mint one with:
#   curl -X POST https://maincloud.spacetimedb.com/v1/identity
# then authorise it (owner, from a trusted machine):
#   spacetime call shootris-game set_attestor '"<identity-hex>"'
# Full walkthrough: infra/spacetimedb-attestor.md
SPACETIMEDB_ATTESTOR_TOKEN=your_attestor_token
# Optional custom Base RPC for signature verification (defaults to public RPC)
# BASE_RPC_URL=https://mainnet.base.org

# Cross-chain NFT verification (/api/holdings) — server-side, optional per chain
# Robinhood Chain values: https://docs.robinhood.com/chain
# ROBINHOOD_CHAIN_ID=
# ROBINHOOD_RPC_URL=
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Farcaster Configuration
NEXT_PUBLIC_HOST=shootris.schmidtiest.xyz
FARCASTER_API_KEY=NEYNAR_FROG_FM

# Shootris card collection on vibe.market (piece-skin unlocks)
# Chain key must exist in src/lib/chains.ts (e.g. robinhood, base)
NEXT_PUBLIC_COLLECTION_CHAIN=robinhood
NEXT_PUBLIC_COLLECTION_CONTRACT=
# STRONGLY RECOMMENDED: the block the collection was deployed at. Without it,
# ownership scans only cover a recent window of chain history.
# COLLECTION_FROM_BLOCK=
# Block range per getLogs chunk if the RPC caps full-range queries
# COLLECTION_LOG_CHUNK=45000
