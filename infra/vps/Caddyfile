# Caddyfile for the VPS front door.
# The VPS terminates TLS (automatic Let's Encrypt) and forwards over the
# private Tailscale tunnel to the home server. Nothing else runs here.
#
# Replace HOME_TAILNET_IP with the home server's Tailscale IP (100.x.y.z,
# from `tailscale ip -4` on the home server).

shootris.schmidtiest.xyz {
	reverse_proxy HOME_TAILNET_IP:3000
	encode gzip
}

# ── Adding a future game ─────────────────────────────────────────────
# 1. Run its container on the home server on a new port (e.g. 3001)
# 2. Add a DNS A record: <game>.schmidtiest.xyz → this VPS's IP
# 3. Copy the block below, fill it in, then: sudo systemctl reload caddy
#
# <game>.schmidtiest.xyz {
# 	reverse_proxy HOME_TAILNET_IP:<port>
# 	encode gzip
# }
